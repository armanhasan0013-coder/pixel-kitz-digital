# Copy to .env.local for local development, and set the same keys in your host (e.g. Vercel).
# Leave a value empty to hide that item on the site — nothing unverified is ever shown.

# ---- Public (exposed to the browser) ----
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, no "+": e.g. 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# ---- Server-only (never exposed) ----
# Inquiry delivery: configure at least one channel, or the form will honestly report it isn't connected.

# Option A — email via Resend (https://resend.com). Requires a verified sending domain.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Pixel Kitz Website <inquiries@your-domain.com>"

# Option B — POST JSON to a webhook (Make, Zapier, n8n, Slack workflow, Supabase Edge Function…)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Option C — local JSONL file at .data/inquiries.jsonl (development / self-hosted only; not for Vercel)
INQUIRY_STORE=
